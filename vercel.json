{
  "buildCommand": "npm run build",
  "outputDirectory": "reachup-audience-first/dist",
  "functions": { "api/enquiry.mjs": { "maxDuration": 30 } },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
