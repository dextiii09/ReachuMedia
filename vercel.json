{
  "buildCommand": "npm run build",
  "outputDirectory": "reachup-audience-first/dist",
  "functions": { "api/enquiry.mjs": { "maxDuration": 30 } },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/portfolio", "destination": "/work", "permanent": true },
    { "source": "/portfolio.html", "destination": "/work", "permanent": true },
    { "source": "/thanks", "destination": "/contact", "permanent": true },
    { "source": "/thanks.html", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
